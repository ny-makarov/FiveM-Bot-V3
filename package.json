    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.1",
    "sucrase": "^3.35.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tscpaths": "^0.0.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@magicyan/core": "^1.2.1",
    "@magicyan/discord": "^1.7.4",
    "chalk": "^4.1.2",
    "consola": "^3.4.2",
    "discord-fivem-api": "^2.0.6",
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "fivem-server-api": "^1.6.1",
    "mysql2": "^3.24.2",
    "tslib": "^2.8.1"
  }
