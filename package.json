{
  "name": "romera-bot",
  "version": "1.0.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "start": "node .",
    "dev": "ts-node -r tsconfig-paths/register --transpiler sucrase/ts-node-plugin src/index.ts",
    "build": "tsc && tscpaths -p tsconfig.json -s ./src -o ./dist"
  },
  "keywords": [
    "bot",
    "discord"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.3.0",
